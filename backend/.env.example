# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can leave MONGODB_URI empty or use your Atlas URI.
# If omitted or unavailable, backend automatically initiates an in-memory/embedded MongoDB instance for zero-friction demo execution.
MONGODB_URI=mongodb://127.0.0.1:27017/agentops-ai

# Security & Authentication
JWT_SECRET=agentops_super_secure_jwt_secret_key_hackathon_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key
# If omitted or invalid, AgentOps AI automatically falls back to deterministic heuristic multi-agent reasoning so demos never fail!
GEMINI_API_KEY=

# Auto-approval threshold (low, medium, high)
AUTO_APPROVE_THRESHOLD=low
